<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Remove="Resources\ResourceBase.resx" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\ResourceBase.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>ResourceBase.Designer.cs</LastGenOutput>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\ResourceBase.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ResourceBase.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\ResourceMath.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ResourceMath.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\ResourcePrefix.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ResourcePrefix.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Extensions\Base\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\ResourceMath.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ResourceMath.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\ResourcePrefix.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>ResourcePrefix.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
