<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="IfDifferent" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Br.Bibliography.Core\Br.Bibliography.Core.csproj" />
    <ProjectReference Include="..\Br.Bibliography.Data\Br.Bibliography.Data.csproj" />
    <ProjectReference Include="..\Br.Bibliography.Model\Br.Bibliography.Model.csproj" />
    <ProjectReference Include="..\Br.Bibliography.Util\Br.Bibliography.Util.csproj" />
    <ProjectReference Include="..\Br.Bibliography.Web\Br.Bibliography.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>